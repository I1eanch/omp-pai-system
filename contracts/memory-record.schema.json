{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp-pai-system:schema:memory-record:1",
  "title": "OMP PAI MEMORY record",
  "description": "One append-only JSONL MEMORY record. Personal facts and preferences additionally require userConfirmed=true at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "content", "source", "confidence", "userConfirmed", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "kind": { "enum": ["fact", "preference", "decision", "lesson", "note"] },
    "content": { "type": "string", "minLength": 1, "maxLength": 32768, "pattern": "\\S" },
    "source": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "userConfirmed": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["fact", "preference"] } }, "required": ["kind"] },
      "then": { "properties": { "userConfirmed": { "const": true } } }
    }
  ]
}
